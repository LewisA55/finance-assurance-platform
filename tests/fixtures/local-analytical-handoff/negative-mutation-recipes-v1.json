{
  "contract_version": "handoff-negative-mutation-recipe-registry@v1",
  "recipe_field_order": [
    "recipe_ref",
    "operation",
    "apply_after_checkpoint",
    "target_ref",
    "operator",
    "before_state",
    "mutation",
    "reseal_steps",
    "request_mutation_ref",
    "expected_first_failure_checkpoint"
  ],
  "execution_rules": [
    "Resolve target_ref within a private mutable fixture copy; never mutate a repository authority or caller source.",
    "Assert before_state byte-for-byte or typed-value-for-typed-value before applying operator.",
    "Apply exactly one operator after apply_after_checkpoint and before the next checkpoint.",
    "Execute reseal_steps in lexical step order, then apply the named request mutation.",
    "The first public failure must occur at expected_first_failure_checkpoint; any earlier or different failure invalidates the fixture.",
    "Restore moved fixture sources and delete private mutation copies after assertion."
  ],
  "operator_vocabulary": [
    "ADD_JSON_ARRAY_ITEM",
    "ADD_JSON_MEMBER",
    "ADD_PATH",
    "ADD_ZIP_MEMBER",
    "CREATE_DIRECTORY",
