  "target_ref_grammar": [
    "REQUEST::<request-field>",
    "SOURCE_PACKAGE::<source-coordinate>::<selector-ref>::<field-name>",
    "SOURCE_MODEL::<package-relative-path>[#<RFC6901-pointer>]",
    "SOURCE_HANDOFF::<package-relative-path>[#<RFC6901-pointer>][::<selector-ref>::<field-name>]",
    "STAGING::<package-relative-path>[#<RFC6901-pointer>][::<selector-ref>::<field-name>]",
    "RUNTIME::<closed-hook-name>"
  ],
  "value_ref_grammar": [
    "ABSENT | ABSENT_CELL | UNAVAILABLE",
    "<scalar-type>:<literal-ASCII>",
    "SHA256:REQUEST_FIELD:<request-field>",
    "SHA256:DERIVED_XLSX_MEMBER:<zip-member-path>",
    "REGULAR_FILE_SHA256:SOURCE_MODEL_MANIFEST_ENTRY:<package-relative-path>",
    "INTEGER:SOURCE_MODEL_ROW_COUNT:<dataset-id>",
    "TEXT:SOURCE_MODEL_DATASET_DIGEST:<dataset-id>",
    "TEXT:CURRENT_TARGET_VALUE",
    "UTF8:AUTHORITY_QUERY:<query-id>",
    "BYTE_AT_OFFSET:<zero-based-integer>:XOR:<two-lower-hex>",
    "JSON:<S-CANONICAL-JSON@v1-value>"
  ],
  "resolution_rules": [
    "CURRENT_TARGET_VALUE resolves before mutation and is then asserted unchanged until the operator applies.",
    "REQUEST_FIELD, SOURCE_MODEL_MANIFEST_ENTRY, SOURCE_MODEL_ROW_COUNT, and SOURCE_MODEL_DATASET_DIGEST resolve only from the already verified request or source model.",
    "AUTHORITY_QUERY resolves to the complete LF-normalized query block headed by the exact query ID in the checked-in SQL authority.",
    "DERIVED_XLSX_MEMBER resolves to the exact member bytes produced by the pinned writer profile before mutation.",
    "All literal payloads are ASCII; JSON payloads parse under S-CANONICAL-JSON@v1 and UTF8 payloads use LF."
  ],
  "operator_contract_field_order": [
    "operator",
    "target_kind",
    "mutation_kind",
    "exact_effect"
  ],
  "operator_contracts": [
    [
      "ADD_JSON_ARRAY_ITEM",
      "JSON array selected by RFC6901",
      "JSON",
      "append exactly one parsed value"
    ],
    [
      "ADD_JSON_MEMBER",
      "JSON object selected by RFC6901",
      "typed scalar",
      "add exactly the named terminal member and reject an existing member"
    ],
    [
      "ADD_PATH",
      "absent package-relative path",
      "UTF8",
      "create one regular file with exact UTF-8 bytes"
    ],
    [
      "ADD_ZIP_MEMBER",
      "absent OPC member",
      "UTF8_XML",
      "create one ZIP member with exact UTF-8 bytes and no other ZIP change"
    ],
    [
      "CREATE_DIRECTORY",
      "absent filesystem path",
      "DIRECTORY_WITH_FILE",
      "create the directory and exact sentinel child"
    ],
    [
      "CREATE_LINK",
      "resolved filesystem path",
      "SYMLINK",
      "replace the private-copy path with the exact relative symbolic link"
    ],
    [
      "DELETE_PATH",
      "existing regular file or directory",
      "ABSENT",
      "remove only the target inside the private mutation copy"
    ],
    [
      "INJECT_FAULT_ONCE",
      "closed runtime hook",
      "OSERROR",
      "raise OSError with the exact ASCII token on the first call only"
    ],
    [
      "MOVE_PATH",
      "existing fixture path",
      "SIBLING_DIRECTORY",
      "atomically move to the exact sibling and restore during cleanup"
    ],
    [
      "REMOVE_RUNTIME_CAPABILITY",
      "closed runtime capability",
      "UNAVAILABLE",
      "hide only the named capability for one fixture process"
    ],
    [
      "REPLACE_FILE_BYTE",
      "regular file verified by SHA256",
      "BYTE_AT_OFFSET",
      "XOR exactly one byte at the declared offset"
    ],
    [
      "REPLACE_SQL_STATEMENT",
      "query block selected by query ID",
      "UTF8",
      "replace the complete block with the exact LF-normalized payload"
    ],
    [
      "REPLACE_ZIP_MEMBER_BYTE",
      "ZIP member verified by SHA256",
      "BYTE_AT_OFFSET",
      "XOR exactly one uncompressed member byte and rebuild no other member"
    ],
    [
      "SET_DATASET_CELL",
      "one selector-resolved source cell",
      "typed scalar",
      "replace the one cell with the exact typed scalar"
    ],
    [
      "SET_DUCKDB_CELL",
      "one selector-resolved DuckDB cell",
      "typed scalar",
      "update exactly one cell in a private database copy"
    ],
    [
      "SET_JSON_POINTER",
      "existing RFC6901 value",
      "typed scalar",
      "replace exactly the selected value"
    ],
    [
      "SET_REQUEST_FIELD",
      "closed request field",
      "typed scalar",
